# Memory Nexus Configuration

# =============================================================================
# DATABASE CONNECTION
# =============================================================================

# PostgreSQL (individual settings)
PG_HOST=localhost
PG_PORT=5432
PG_DB=claude
PG_USER=postgres
PG_PASSWORD=your_password_here

# =============================================================================
# EMBEDDING MODEL
# =============================================================================

# Default: intfloat/multilingual-e5-large (1024 dims, multilingual, best quality)
# Alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (384 dims, faster)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================

# Hybrid search weights (semantic + keyword should = 1.0)
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# Minimum similarity threshold for results
MIN_SIMILARITY=0.15

# Enable cross-encoder reranking
USE_RERANKING=true
RERANK_TOP_K=10

# =============================================================================
# CHUNKING
# =============================================================================

CHUNK_MAX_SIZE=1500
CHUNK_OVERLAP=200
CHUNK_MIN_SIZE=100

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
