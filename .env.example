# Memory Nexus configuration. Copy to .env in the repository root.
# Every variable here is read by config/settings.py; defaults are shown.

# -----------------------------------------------------------------------------
# PostgreSQL (with the pgvector extension, >= 0.5.0)
# -----------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DB=memory_nexus
PG_USER=postgres
PG_PASSWORD=change_me

# true: the server creates missing tables and indexes on startup.
# false: run as a least-privilege role without DDL rights; apply migrations
#        separately with an owner role (python init_db.py).
AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# The code loads the model through FlagEmbedding's BGEM3FlagModel, so it expects
# BGE-M3 (or a model with the same architecture and pooling). Pointing it at a
# different family (e5, MiniLM) will load but produce degraded vectors.
# Changing the model requires re-embedding: reembed_all.py, then
# build_tag_index.py --rebuild.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------
MIN_SIMILARITY=0.15
RRF_K=60
TAG_TOP_K=8
TAG_MIN_SIMILARITY=0.5

# -----------------------------------------------------------------------------
# Chunking (characters)
# -----------------------------------------------------------------------------
CHUNK_MAX_SIZE=1500
CHUNK_OVERLAP=200
CHUNK_MIN_SIZE=100
